# OpenRouter — Arquivo de Configuração de Ambiente
#
# INSTRUÇÕES:
# 1. Copie este arquivo: cp openrouter.env.example ~/.config/ai-tools/openrouter.env
# 2. Preencha suas chaves reais no arquivo copiado
# 3. NUNCA commite o arquivo com chaves reais
# 4. O arquivo ~/.config/ai-tools/openrouter.env é carregado automaticamente
#    pelo shell (zsh/fish) após o rebuild do sistema
#
# Obtenha sua chave em: https://openrouter.ai/settings/keys

# ── Chave principal ──────────────────────────────────────────────────────────
export OPENROUTER_API_KEY="sk-or-..."

# ── Configuração para Claude Code (usa ANTHROPIC_* vars) ────────────────────
# Rota Claude Code pelo OpenRouter em vez da API Anthropic direta.
# ANTHROPIC_API_KEY deve ser explicitamente vazio para evitar conflitos.
export ANTHROPIC_BASE_URL="https://openrouter.ai/api"
export ANTHROPIC_AUTH_TOKEN="$OPENROUTER_API_KEY"
export ANTHROPIC_API_KEY=""

# ── Modelos opcionais (descomente e ajuste conforme necessidade) ─────────────
# export ANTHROPIC_DEFAULT_OPUS_MODEL="~anthropic/claude-opus-latest"
# export ANTHROPIC_DEFAULT_SONNET_MODEL="~anthropic/claude-sonnet-latest"
# export ANTHROPIC_DEFAULT_HAIKU_MODEL="~anthropic/claude-haiku-latest"
# export CLAUDE_CODE_SUBAGENT_MODEL="~anthropic/claude-sonnet-latest"

# ── Outras chaves (opcional — para acesso direto sem OpenRouter) ─────────────
# export ANTHROPIC_API_KEY_DIRECT="sk-ant-..."   # somente se usar Anthropic diretamente
# export OPENAI_API_KEY="sk-..."                 # somente se usar OpenAI diretamente
# export GOOGLE_API_KEY="..."                    # somente se usar Gemini diretamente
