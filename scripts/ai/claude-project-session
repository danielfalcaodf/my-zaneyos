#!/usr/bin/env bash
# claude-project-session — Inicia sessão Claude Code no projeto correto
# Uso: claude-project-session [--project <nome>] [-- <args claude>]
set -euo pipefail

GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
RED='\033[0;31m'
NC='\033[0m'

info()  { echo -e "${CYAN}ℹ${NC}  $*"; }
ok()    { echo -e "${GREEN}✔${NC}  $*"; }
warn()  { echo -e "${YELLOW}⚠${NC}  $*"; }
die()   { echo -e "${RED}✘${NC}  $*" >&2; exit 1; }

PROJECT=""
CLAUDE_ARGS=()

while [[ $# -gt 0 ]]; do
  case "$1" in
    --project|-p) shift; PROJECT="$1"; shift ;;
    --) shift; CLAUDE_ARGS=("$@"); break ;;
    --help|-h)
      echo "Uso: claude-project-session [--project <nome>] [-- <args claude>]"
      echo ""
      echo "Inicia Claude Code no diretório do projeto com status inicial."
      echo "Se zellij disponível, cria sessão nomeada."
      exit 0 ;;
    *) die "Argumento desconhecido: $1" ;;
  esac
done

command -v claude &>/dev/null || die "claude não encontrado (instale via zcli rebuild)"

# Determinar diretório
if [[ -n "$PROJECT" ]]; then
  for search_dir in "$HOME/repos/$PROJECT" "$HOME/$PROJECT"; do
    if [[ -d "$search_dir/.git" ]]; then
      PROJECT_DIR="$search_dir"
      break
    fi
  done
  [[ -n "${PROJECT_DIR:-}" ]] || die "Projeto '$PROJECT' não encontrado"
else
  git -C "$(pwd)" rev-parse --git-dir &>/dev/null || \
    die "Não está em um git repo. Use --project <nome>."
  PROJECT_DIR="$(pwd)"
fi

PROJECT_NAME="$(basename "$PROJECT_DIR")"
BRANCH="$(git -C "$PROJECT_DIR" branch --show-current 2>/dev/null || echo '?')"

echo ""
echo -e "${CYAN}━━ Claude Code Session ━━${NC}"
info "Projeto:   $PROJECT_NAME"
info "Diretório: $PROJECT_DIR"
info "Branch:    $BRANCH"
echo ""

# Mostrar status resumido
git -C "$PROJECT_DIR" status --short 2>/dev/null | head -10 || true
echo ""

SESSION_NAME="claude-$PROJECT_NAME"

cd "$PROJECT_DIR"
if command -v zellij &>/dev/null; then
  ok "Sessão zellij: $SESSION_NAME"
  exec zellij --session "$SESSION_NAME" -- claude "${CLAUDE_ARGS[@]:-}"
else
  exec claude "${CLAUDE_ARGS[@]:-}"
fi
