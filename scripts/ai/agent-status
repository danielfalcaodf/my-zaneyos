#!/usr/bin/env bash
# agent-status — Mostra status do repositório antes de iniciar sessão de agente
# Uso: agent-status [<diretório>]
set -euo pipefail

GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
RED='\033[0;31m'
NC='\033[0m'

info()    { echo -e "${CYAN}ℹ${NC}  $*"; }
ok()      { echo -e "${GREEN}✔${NC}  $*"; }
warn()    { echo -e "${YELLOW}⚠${NC}  $*"; }
section() { echo -e "\n${CYAN}━━ $* ━━${NC}"; }

TARGET_DIR="${1:-.}"
cd "$TARGET_DIR"

git rev-parse --git-dir &>/dev/null || {
  echo -e "${RED}✘${NC}  Não está em um repositório git: $TARGET_DIR" >&2
  exit 1
}

echo ""
echo -e "${CYAN}╔═══════════════════════════════════════════════╗${NC}"
echo -e "${CYAN}║         Agent Status — Pré-sessão             ║${NC}"
echo -e "${CYAN}╚═══════════════════════════════════════════════╝${NC}"

section "Repositório"
info "Diretório: $(pwd)"
info "Branch:    $(git branch --show-current)"
info "Commit:    $(git log --oneline -1 2>/dev/null || echo 'sem commits')"

section "Status Git"
git status --short 2>/dev/null || true

# Verificar arquivos .env no staged
if git diff --cached --name-only 2>/dev/null | grep -q "\.env"; then
  warn "ATENÇÃO: há arquivos .env em stage! Remova antes de commitar."
fi

section "Últimos commits"
git log --oneline -5 2>/dev/null || true

section "Branches"
git branch -a 2>/dev/null | head -10 || true

section "Verificações de segurança"
# Verificar .env não commitados
env_files=$(find . -name ".env" -not -path "./.git/*" 2>/dev/null || true)
if [[ -n "$env_files" ]]; then
  warn "Arquivos .env presentes (não commite estes arquivos):"
  echo "$env_files" | while read -r f; do warn "  $f"; done
else
  ok "Nenhum arquivo .env encontrado"
fi

# Verificar gitleaks se disponível
if command -v gitleaks &>/dev/null; then
  if gitleaks detect --no-git --source . &>/dev/null 2>&1; then
    ok "gitleaks: nenhum secret detectado"
  else
    warn "gitleaks detectou possíveis secrets — revise antes de commitar"
  fi
fi

echo ""
ok "Status completo. Pronto para iniciar sessão do agente."
echo ""
