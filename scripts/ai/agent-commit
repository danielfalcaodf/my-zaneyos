#!/usr/bin/env bash
# agent-commit — Helper de commit seguro para agentes de IA
# Mostra diff, pede confirmação e cria commit com mensagem descritiva.
# Nunca usa `git add .` — requer arquivos específicos.
#
# Uso: agent-commit <arquivo1> [arquivo2 ...] -- "mensagem de commit"
set -euo pipefail

GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
RED='\033[0;31m'
NC='\033[0m'

info()  { echo -e "${CYAN}ℹ${NC}  $*"; }
ok()    { echo -e "${GREEN}✔${NC}  $*"; }
warn()  { echo -e "${YELLOW}⚠${NC}  $*"; }
die()   { echo -e "${RED}✘${NC}  $*" >&2; exit 1; }

# ─── Validações básicas ───────────────────────────────────────────────────────
git rev-parse --git-dir &>/dev/null || die "Não está em um repositório git"

[[ $# -ge 3 ]] || {
  echo "Uso: agent-commit <arquivo1> [arquivo2 ...] -- 'mensagem de commit'"
  echo ""
  echo "Exemplo:"
  echo "  agent-commit modules/ai-tools/tier3.nix -- 'feat(ai-tools): add opencode-desktop TODO'"
  exit 1
}

# Separar arquivos da mensagem
FILES=()
MESSAGE=""
separator_found=false
for arg in "$@"; do
  if [[ "$separator_found" == true ]]; then
    MESSAGE="$arg"
  elif [[ "$arg" == "--" ]]; then
    separator_found=true
  else
    FILES+=("$arg")
  fi
done

[[ "${#FILES[@]}" -gt 0 ]] || die "Nenhum arquivo especificado antes do --"
[[ -n "$MESSAGE" ]] || die "Mensagem de commit não especificada após o --"

# ─── Verificar se algum arquivo é sensível ───────────────────────────────────
SENSITIVE_PATTERNS=(".env" ".key" ".pem" "id_rsa" "id_ed25519" ".secret" "secrets/")
for file in "${FILES[@]}"; do
  for pattern in "${SENSITIVE_PATTERNS[@]}"; do
    if [[ "$file" == *"$pattern"* ]]; then
      die "BLOQUEADO: '$file' parece ser um arquivo sensível. Não commite arquivos .env ou chaves."
    fi
  done
done

# ─── Verificar arquivos existentes ───────────────────────────────────────────
for file in "${FILES[@]}"; do
  [[ -f "$file" ]] || warn "Arquivo não encontrado: $file (pode ter sido deletado)"
done

# ─── Mostrar diff ─────────────────────────────────────────────────────────────
echo ""
echo -e "${CYAN}━━ Diff dos arquivos a serem commitados ━━${NC}"
git diff HEAD -- "${FILES[@]}" 2>/dev/null || git diff -- "${FILES[@]}" 2>/dev/null || true
echo ""

# ─── Confirmação ─────────────────────────────────────────────────────────────
info "Arquivos:  ${FILES[*]}"
info "Mensagem:  $MESSAGE"
echo ""
read -rp "$(echo -e "${YELLOW}Confirmar commit? [s/N]${NC} ")" confirm
confirm=$(echo "$confirm" | tr '[:upper:]' '[:lower:]')
[[ "$confirm" == "s" || "$confirm" == "sim" || "$confirm" == "y" || "$confirm" == "yes" ]] || {
  warn "Commit cancelado."
  exit 0
}

# ─── Commitar ────────────────────────────────────────────────────────────────
git add -- "${FILES[@]}"
git commit -m "$MESSAGE"
ok "Commit criado com sucesso."
echo ""
git log --oneline -3
echo ""
warn "Lembre: faça o push manualmente quando estiver pronto."
warn "  git push origin $(git branch --show-current)"
