# Woodpecker CI — Variáveis de Ambiente
# Copie para .env e preencha antes de executar: zstack init automation/woodpecker
#
# NUNCA commite o arquivo .env com valores reais.
# O .env está no .gitignore do repositório.

# ─── Servidor ──────────────────────────────────────────────────────────────────
# URL pública de acesso ao Woodpecker (sem trailing slash).
# Exemplos:
#   http://woodpecker.homelab.lan      (via Caddy reverse proxy)
#   http://192.168.0.10:8000           (acesso direto por IP)
WOODPECKER_HOST=http://woodpecker.homelab.lan

# Porta exposta no host (acesso local, via 127.0.0.1)
WOODPECKER_SERVER_PORT=8000

# Permitir auto-cadastro de novos usuários (true = aberto, false = apenas admin)
WOODPECKER_OPEN=true

# Usuário(s) admin separados por vírgula (username do GitHub)
WOODPECKER_ADMIN=daniel

# ─── Integração GitHub ────────────────────────────────────────────────────────
# Para criar o OAuth App no GitHub:
#   1. Acesse: https://github.com/settings/developers → OAuth Apps → New OAuth App
#   2. Application name: Woodpecker CI (Homelab)
#   3. Homepage URL: valor de WOODPECKER_HOST
#   4. Authorization callback URL: ${WOODPECKER_HOST}/authorize
#      Exemplo: http://woodpecker.homelab.lan/authorize
#   5. Copie Client ID e Client Secret abaixo
WOODPECKER_GITHUB=true
WOODPECKER_GITHUB_CLIENT=change-me
WOODPECKER_GITHUB_SECRET=change-me

# ─── Segredo do Agent ─────────────────────────────────────────────────────────
# Segredo compartilhado entre server e agent. Gere com:
#   openssl rand -hex 32
# OBRIGATÓRIO: troque antes de subir o stack.
WOODPECKER_AGENT_SECRET=change-me-generate-with-openssl-rand-hex-32
