# Homepage — Variáveis de Ambiente
# Copie para .env e preencha antes de executar: zstack init homelab/homepage
#
# NUNCA commite o arquivo .env com valores reais.
# O .env está no .gitignore do repositório.

# ─── Hosts permitidos ─────────────────────────────────────────────────────────
# Lista de hosts/IPs permitidos para acessar o Homepage.
# Separados por vírgula, SEM espaços.
# Inclua TODOS os hosts/IPs/portas usados para acessar o Dashboard.
#
# Exemplos por tipo de acesso:
#
# Via hostname local (com Caddy/DNS local):
#   homepage.homelab.lan,home.homelab.lan
#
# Via localhost (desenvolvimento/teste):
#   localhost:3003,127.0.0.1:3003
#
# Via IP da LAN (sem reverse proxy):
#   192.168.0.10:3003
#
# Combinado (recomendado para homelab):
#   homepage.homelab.lan,home.homelab.lan,localhost:3003,127.0.0.1:3003
#
# Se o erro "Host validation failed" aparecer:
#   1. Execute: zstack logs homelab/homepage
#   2. Copie o host exato que aparece no log (ex: "192.168.0.10:3003")
#   3. Adicione-o nesta variável e recrie o container:
#      zstack restart homelab/homepage
#
# ATENÇÃO: "*" desabilita a validação e NÃO é recomendado para uso normal.
# Use apenas como debug temporário e remova depois.
HOMEPAGE_ALLOWED_HOSTS=homepage.homelab.lan,home.homelab.lan,localhost:3003,127.0.0.1:3003

# ─── Porta do host ────────────────────────────────────────────────────────────
# Porta exposta no host (container sempre usa 3000 internamente).
HOMEPAGE_HOST_PORT=3003
