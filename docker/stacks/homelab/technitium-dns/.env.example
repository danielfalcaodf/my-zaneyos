# Technitium DNS Server Configuration
# Copy to .env and configure

# Admin password for Web UI (generate with: openssl rand -base64 32)
ADMIN_PASSWORD=changeme_strong_password

# Local domain for wildcard DNS
LOCAL_DOMAIN=homelab.lan

# LAN IP for wildcard resolution (*.homelab.lan -> LAN IP)
LAN_IP=192.168.33.101

# Upstream DNS servers (comma-separated)
UPSTREAM_DNS=9.9.9.9,1.1.1.1

# Enable DNS-over-HTTPS
ENABLE_DOH=true

# Log level
LOG_LEVEL=info