# Porta no host (Caddy faz proxy para cá). open-webui já usa 8080.
SANDBOX_HOST_PORT=8090

# Pasta do host montada como workspace da IA (caminho absoluto).
REPOS_DIR=${HOME}/repos
WORKSPACE=/home/gem/repos

TZ=America/Sao_Paulo

# Proxy de saída (vazio = sem proxy). Ex: host.docker.internal:7890
PROXY_SERVER=

# Autenticação opcional por JWT (chave pública PEM). Vazio = sem auth.
# Recomendado preencher já que o serviço fica exposto na LAN via Caddy.
JWT_PUBLIC_KEY=

# DNS-over-HTTPS templates para o browser interno (vazio = padrão).
DNS_OVER_HTTPS_TEMPLATES=

# Args extras do Chrome (vazio = padrão).
BROWSER_EXTRA_ARGS=

# Portas que o sandbox aguarda ficarem prontas antes de liberar (vazio = padrão).
WAIT_PORTS=
